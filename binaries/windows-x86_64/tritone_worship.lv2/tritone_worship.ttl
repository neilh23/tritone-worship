@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:tritoneworship:tritoneworship>
    a lv2:Plugin, lv2:PitchPlugin ;
    doap:name "TritoneWorship" ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "amount" ; lv2:name "Amount" ;
        lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "bass" ; lv2:name "Bass" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "blacken" ; lv2:name "Blacken" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "trem_amount" ; lv2:name "Tremolo Amount" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "trem_speed" ; lv2:name "Tremolo Speed" ;
        lv2:default 800.0 ; lv2:minimum 666.0 ; lv2:maximum 1666.0 ;
        units:unit units:bpm
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 6 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 7 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 8 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 9 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency, lv2:integer ;
        lv2:minimum 0 ; lv2:maximum 4096
    ] .
